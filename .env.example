# OneWeb API service URLs (include the API base path, excluding endpoint paths)
ONEWEB_INVENTORY_URL=
ONEWEB_MANAGEMENT_URL=
ONEWEB_PERFORMANCE_URL=

# The provided RAML contracts specify Basic authentication.
ONEWEB_AUTH_TYPE=basic
ONEWEB_USERNAME=
ONEWEB_PASSWORD=

# Optional if your API gateway explicitly supports Bearer authentication:
# ONEWEB_AUTH_TYPE=bearer
# ONEWEB_TOKEN=

# OpsCenter Poller (optional; cookie stored outside the repository)
OPSCENTER_BASE_URL=
# OPSCENTER_COOKIE_FILE=/home/you/.config/nxwv-toolkit/auth/opscenter.cookie

# Required for LTEF downloads; configure the source URL here, not in source code.
ONEWEB_EPHEMERIS_URL=https://ephemeris.oneweb.net/ltef/ltef.csv

# Optional LTEF snapshot directory (defaults to project .local/ephemeris, gitignored)
# ONEWEB_EPHEMERIS_DIR=/absolute/path/to/ephemeris

# Optional: use the OS trust bundle for HTTPS (e.g. corporate/Viasat CA in Ubuntu).
# HTTPX defaults to certifi; set this when the OS trusts a CA that certifi lacks.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

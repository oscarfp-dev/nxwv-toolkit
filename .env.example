# OneWeb API service URLs (include the API base path, excluding endpoint paths)
ONEWEB_INVENTORY_URL=https://api.example.com/api/resourceInventory/v3
ONEWEB_MANAGEMENT_URL=https://api.example.com/api/userTerminalMgmt/v1
ONEWEB_PERFORMANCE_URL=https://api.example.com/api/performanceMonitoring/v2

# The provided RAML contracts specify Basic authentication.
ONEWEB_AUTH_TYPE=basic
ONEWEB_USERNAME=
ONEWEB_PASSWORD=

# Optional if your API gateway explicitly supports Bearer authentication:
# ONEWEB_AUTH_TYPE=bearer
# ONEWEB_TOKEN=
